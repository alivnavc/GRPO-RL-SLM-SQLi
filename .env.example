# Copy this to .env and fill in your credentials
# cp .env.example .env

# LLM Provider (choose one)
# Options: mock (no key needed), openai, anthropic
LLM_PROVIDER=mock

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Anthropic (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Flask target app port (default: 5001)
SQLI_APP_PORT=5001

# SQLite DB path for the mock app (default: :memory:)
SQLI_DB_PATH=:memory:

# Results output directory
RESULTS_DIR=results/
